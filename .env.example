# optional
LISTEN_ADDRESS=127.0.0.1:55556
LOG_LEVEL=info                              # debug, info, warn, error
LOG_FORMAT=text                             # text or json

# any OpenAI-compatible API with image input; defaults to local ollama
OPENAI_BASE_URL=http://127.0.0.1:11434/v1
OPENAI_MODEL=qwen2.5vl:3b                   # smallest model that works
# OPENAI_API_KEY=                           # sent as a bearer token if set

